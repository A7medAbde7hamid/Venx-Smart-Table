{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitu-ai.local/schemas/timetable.schema.json",
  "title": "HITU AI Timetable",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "term", "sessions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "term": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "courseId",
        "courseName",
        "type",
        "week",
        "day",
        "start",
        "end",
        "instructor",
        "room",
        "sections"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "courseId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "courseName": { "type": "string", "minLength": 1 },
        "type": { "enum": ["lecture", "section"] },
        "week": { "enum": ["W1", "W2"] },
        "day": { "enum": ["sat", "sun", "mon", "tue", "wed", "thu", "fri"] },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "instructor": { "type": "string", "minLength": 1 },
        "room": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 15 }
        }
      }
    }
  }
}
